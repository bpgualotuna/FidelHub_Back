# ChatControl Backend — copiar a .env
# WhatsApp y Gemini por empresa: panel Integraciones (BD cifrada), no hace falta repetirlos aquí.

# --- Obligatorio ---
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/postgres?sslmode=require
SUPABASE_URL=aqui-tu-supabase-url
SUPABASE_KEY=aqui-tu-supabase-anon-key-o-service-role

# JWT (login con email/contraseña de usuarios en BD)
JWT_SECRET=cambiar-en-produccion-por-un-secreto-largo-y-aleatorio
JWT_REFRESH_SECRET=cambiar-por-otro-secreto-largo-y-aleatorio

# Cifrado de secretos guardados en BD (integraciones). Mínimo 32 caracteres.
ENCRYPTION_MASTER_KEY=cambiar-por-cadena-de-al-menos-32-caracteres

# Meta verifica el webhook con GET usando este token (mismo valor que en Meta Developer Console).
WHATSAPP_VERIFY_TOKEN=definir-token-de-verificacion

# --- Opcional (valores por defecto en código si omites) ---
PORT=3001
NODE_ENV=development
JWT_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=30d
FRONTEND_URL=http://localhost:3002

# Empresa por defecto para webhook cuando Meta envía el phone_number_id del .env de desarrollo (ver código).
# DEFAULT_ORGANIZATION_ID=org_default_migration

# Login legacy: POST /auth/login-legacy (teléfono + contraseña). Si no usas ese flujo, omite.
# APP_LOGIN_PASSWORD=

# Sandbox Meta: restricción de números de prueba (por defecto true si no defines).
# WHATSAPP_SANDBOX=false

# Solo desarrollo / fallback: si la empresa no tiene credenciales en BD, el código puede leer esto.
# No uses en producción multi-tenant; configura Integraciones en la app.
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_BUSINESS_ACCOUNT_ID=
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# Seed: npx prisma db seed — ver prisma/seed.ts
# SEED_ADMIN_EMAIL, SEED_ADMIN_PASSWORD, SEED_LEGACY_PHONE
# SEED_SUPERADMIN=true + SEED_SUPERADMIN_EMAIL + SEED_SUPERADMIN_PASSWORD (si no, usa SEED_ADMIN_PASSWORD)

# --- Integración CRM (vinculación automática por env) ---
# Si se define, al iniciar ChatControl crea automáticamente una integración
# para la primera organización activa, sin necesidad del flujo de vinculación.
# El CRM debe usar el mismo valor en CHATCONTROL_API_KEY.
# CRM_DEFAULT_API_KEY=crm-api-key-por-defecto



